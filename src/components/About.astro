---
import SectionHeading from './SectionHeading.astro';
import { aboutParagraphs, facts } from '../data/about';
import { useI18n } from '../i18n';

const { t, ui } = useI18n(Astro.currentLocale);
const paragraphs = t(aboutParagraphs);
---

<section class="section" id="about">
  <div class="container">
    <SectionHeading
      title={ui.sections.about.title}
    />

    <div class="about">
      <div class="about__body">
        {
          /* Rendered as HTML so the <strong> emphasis can live in the copy
             itself — see the note in src/data/about.ts. */
          paragraphs.map((html, i) => (
            <p
              class={i === 0 ? 'about__lead' : undefined}
              data-reveal
              style={`--reveal-delay: ${i * 60}ms`}
              set:html={html}
            />
          ))
        }
      </div>

      <aside class="about__facts" data-reveal style="--reveal-delay: 120ms">
        <dl>
          {
            facts.map((fact) => (
              <div class="fact">
                <dt>{t(fact.label)}</dt>
                <dd>{t(fact.value)}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--text-muted);
    max-width: 46rem;
  }

  .about__lead {
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    color: var(--text);
  }

  .about__body :global(strong) {
    font-weight: 550;
    color: var(--text);
  }

  /* --- Quick facts --- */
  .about__facts {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-elev);
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .fact + .fact {
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border);
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .fact dd {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__facts {
      position: static;
    }
  }
</style>
