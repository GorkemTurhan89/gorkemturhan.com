---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { contactLinks } from '../data/site';
import { useI18n } from '../i18n';

const { t, ui } = useI18n(Astro.currentLocale);

/* mailto: and the same-origin CV download should not open a new tab. */
const isExternal = (href: string) => href.startsWith('http');
---

<section class="section" id="contact">
  <div class="container">
    <SectionHeading
      title={ui.sections.contact.title}
      lead={ui.sections.contact.lead}
    />

    <ul class="grid">
      {
        contactLinks.map((link, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <a
              class="card contact"
              href={link.href}
              download={link.download}
              data-copy-email={link.href.startsWith('mailto:') || undefined}
              data-copied-label={
                link.href.startsWith('mailto:') ? ui.contact.copied : undefined
              }
              target={isExternal(link.href) ? '_blank' : undefined}
              rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
            >
              <span class="contact__icon">
                <Icon name={link.icon} size="1.15rem" />
              </span>

              <span class="contact__text">
                <span class="contact__label">{t(link.label)}</span>
                <span class="contact__handle">{t(link.handle)}</span>
              </span>

              <span class="contact__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size="1rem" />
              </span>

              {link.href.startsWith('mailto:') && (
                <span class="contact__copied" role="status" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Fixed column counts rather than auto-fit: the four cards should go from
     one row to two to a single stack, never through a three-up step that
     would strand the last one on a row of its own. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 34rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* With an odd number of cards the last one would sit alone beside a gap.
       Let it span the row instead, so it reads as a closing call to action. */
    .grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* The longest handle — the email address — runs about 10rem, so a card
     needs some 13rem of column to keep it on one line. Four of those plus
     the gaps and the page gutter clear the container at 62rem. */
  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }

    /* Four columns leave no gap for a lone last card to fill. */
    .grid > li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  .contact {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1.15rem 1.25rem;
  }

  .contact:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-elev-2);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .contact:hover .contact__icon {
    color: var(--accent);
    border-color: var(--accent-tint);
  }

  .contact__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact__label {
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.3;
  }

  /* Wraps rather than truncates — an ellipsised email address is useless. */
  .contact__handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-dim);
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    margin-left: auto;
    color: var(--text-dim);
    opacity: 0;
    translate: -4px 0;
    transition: opacity var(--dur) var(--ease), translate var(--dur) var(--ease);
  }

  .contact:hover .contact__arrow,
  .contact:focus-visible .contact__arrow {
    opacity: 1;
    translate: 0 0;
  }

  /* Clipboard confirmation. Sits exactly where the arrow does and is taken
     out of the flow, so the card cannot change width when it appears. */
  .contact__copied {
    position: absolute;
    right: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
    pointer-events: none;
  }

  /* Last, so it wins over the hover rule above while the message shows. */
  .contact.is-copied .contact__copied {
    opacity: 1;
  }

  .contact.is-copied .contact__arrow {
    opacity: 0;
  }

  /* A quarter-width column cannot hold the icon and a full email address
     beside each other, so the four-up row stacks them and hands the handle
     the whole width of the card. */
  @media (min-width: 62rem) {
    .contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    /* There is no row left for the arrow to sit at the end of. Pin it to the
       top corner instead — the same spot the confirmation message uses, so
       the two still swap in place. */
    .contact__arrow {
      position: absolute;
      top: 1.15rem;
      right: 1.25rem;
      margin-left: 0;
    }

    .contact__copied {
      top: 1.15rem;
    }
  }
</style>

<script>
  /**
   * Clipboard fallback for the email card.
   *
   * The href stays a plain `mailto:` and is never intercepted — this only
   * adds a second outcome for visitors whose machine has no handler
   * registered for the protocol, which is common for anyone reading their
   * mail in a browser tab. There the click does nothing at all and the
   * browser reports nothing back, so it cannot be detected and recovered
   * from after the fact; the address has to be handed over up front.
   *
   * Anything failing in here leaves the card exactly as it was.
   */
  const cards = document.querySelectorAll<HTMLAnchorElement>('[data-copy-email]');

  for (const card of cards) {
    card.addEventListener('click', () => {
      /* Read the address off the href rather than carrying a copy of it in
         an attribute. Cloudflare's email obfuscation rewrites the href in
         the served HTML and restores it in the browser; a second copy sitting
         in the markup would hand the address straight back to the scrapers
         that feature exists to stop. If the bail-out below ever fires, the
         rewrite has not been undone and there is nothing safe to copy. */
      const href = card.getAttribute('href') ?? '';
      const status = card.querySelector('[role="status"]');

      if (!href.startsWith('mailto:') || !status || !navigator.clipboard) return;

      const address = href.slice('mailto:'.length).split('?')[0];

      navigator.clipboard
        .writeText(address)
        .then(() => {
          card.classList.add('is-copied');
          /* Written rather than pre-rendered so the live region announces it. */
          status.textContent = card.dataset.copiedLabel ?? '';

          window.setTimeout(() => {
            card.classList.remove('is-copied');
            status.textContent = '';
          }, 2000);
        })
        .catch(() => {
          /* Denied permission or an insecure context — the mailto: still ran. */
        });
    });
  }
</script>
