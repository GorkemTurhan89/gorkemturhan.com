---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { contactLinks } from '../data/site';
import { useI18n } from '../i18n';

const { t, ui } = useI18n(Astro.currentLocale);

/* mailto: and the same-origin CV download should not open a new tab. */
const isExternal = (href: string) => href.startsWith('http');
---

<section class="section" id="contact">
  <div class="container">
    <SectionHeading
      title={ui.sections.contact.title}
      lead={ui.sections.contact.lead}
    />

    <ul class="grid">
      {
        contactLinks.map((link, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <a
              class="card contact"
              href={link.href}
              download={link.download}
              target={isExternal(link.href) ? '_blank' : undefined}
              rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
            >
              <span class="contact__icon">
                <Icon name={link.icon} size="1.15rem" />
              </span>

              <span class="contact__text">
                <span class="contact__label">{t(link.label)}</span>
                <span class="contact__handle">{t(link.handle)}</span>
              </span>

              <span class="contact__arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size="1rem" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* 22rem forces two roomy columns rather than four cramped ones, so a full
     email address fits on one line instead of breaking mid-word. It also
     caps the grid at two columns at every width the container reaches. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }

  /* With an odd number of cards the last one would sit alone beside a gap.
     Let it span the row instead, so it reads as a closing call to action.
     No-op in the single-column layout. */
  .grid > li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .contact {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1.15rem 1.25rem;
  }

  .contact:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-elev-2);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .contact:hover .contact__icon {
    color: var(--accent);
    border-color: var(--accent-tint);
  }

  .contact__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact__label {
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.3;
  }

  /* Wraps rather than truncates — an ellipsised email address is useless. */
  .contact__handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-dim);
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    margin-left: auto;
    color: var(--text-dim);
    opacity: 0;
    translate: -4px 0;
    transition: opacity var(--dur) var(--ease), translate var(--dur) var(--ease);
  }

  .contact:hover .contact__arrow,
  .contact:focus-visible .contact__arrow {
    opacity: 1;
    translate: 0 0;
  }
</style>
