---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/experience';
import { useI18n } from '../i18n';

const { t, ui } = useI18n(Astro.currentLocale);
---

<section class="section" id="experience">
  <div class="container">
    <SectionHeading
      title={ui.sections.experience.title}
      lead={ui.sections.experience.lead}
    />

    <ol class="timeline">
      {
        experience.map((job, i) => (
          <li class="entry" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="entry__rail" aria-hidden="true">
              <span class="entry__dot" />
            </div>

            <div class="entry__body">
              <p class="entry__period">{t(job.period)}</p>

              {/* The space matters: the heading is a flex container, so it
                  is ignored for layout but keeps the accessible name from
                  reading as "QA EngineerMars Athletic Club". */}
              <h3 class="entry__role">
                {t(job.role)} <span class="entry__company">{job.company}</span>
              </h3>

              {job.location && (
                <p class="entry__location">{t(job.location)}</p>
              )}

              <ul class="entry__highlights">
                {t(job.highlights).map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>

              <ul class="chip-list entry__stack">
                {job.stack.map((tech) => (
                  <li class="chip">{tech}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .entry {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0 1.25rem;
  }

  /* --- Rail: the vertical line plus the marker --- */
  .entry__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* The connecting line, stopped short on the final entry. */
  .entry__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .entry:last-child .entry__rail::before {
    bottom: auto;
    height: 1.5rem;
  }

  .entry__dot {
    position: relative;
    margin-top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--border-strong);
    transition: box-shadow var(--dur) var(--ease);
  }

  .entry:hover .entry__dot {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-tint);
  }

  /* --- Body --- */
  .entry__body {
    padding-bottom: 2.75rem;
  }

  .entry:last-child .entry__body {
    padding-bottom: 0;
  }

  .entry__period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }

  .entry__role {
    margin-top: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.125rem;
  }

  .entry__company {
    color: var(--accent);
    font-weight: 500;
  }

  .entry__company::before {
    content: '/ ';
    color: var(--text-dim);
  }

  .entry__location {
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .entry__highlights {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-width: 46rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .entry__highlights li {
    position: relative;
    padding-left: 1.15rem;
  }

  .entry__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 1px;
    background: var(--accent);
    opacity: 0.7;
  }

  .entry__stack {
    margin-top: 1.15rem;
  }

  @media (max-width: 560px) {
    .entry {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0 0.85rem;
    }
  }
</style>
