---
import { site, navItems } from '../data/site';
import { LANGS, LANG_META, pathFor, useI18n } from '../i18n';
import Icon from './Icon.astro';

const { lang, ui } = useI18n(Astro.currentLocale);
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a class="brand" href="#top" aria-label={`${site.name} — ${ui.backToTopAria}`}>
      <span class="brand__mark" aria-hidden="true">{site.initials}</span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul class="nav__list">
        {
          navItems.map((item) => (
            <li>
              <a class="nav__link" href={item.href} data-nav-link>
                {ui.nav[item.key]}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Duplicated inside the panel so the switcher is reachable on mobile,
          where the header row has no space for it. */}
      <div class="nav__lang">
        <span class="lang" role="group" aria-label={ui.switchLanguage}>
          {
            LANGS.map((code) =>
              code === lang ? (
                <span class="lang__item is-current" aria-current="true">
                  {LANG_META[code].short}
                </span>
              ) : (
                <a
                  class="lang__item"
                  href={pathFor(code)}
                  hreflang={code}
                  lang={code}
                  aria-label={LANG_META[code].name}
                >
                  {LANG_META[code].short}
                </a>
              ),
            )
          }
        </span>
      </div>
    </nav>

    <span class="lang lang--header" role="group" aria-label={ui.switchLanguage}>
      {
        LANGS.map((code) =>
          code === lang ? (
            <span class="lang__item is-current" aria-current="true">
              {LANG_META[code].short}
            </span>
          ) : (
            <a
              class="lang__item"
              href={pathFor(code)}
              hreflang={code}
              lang={code}
              aria-label={LANG_META[code].name}
            >
              {LANG_META[code].short}
            </a>
          ),
        )
      }
    </span>

    {
      site.availableForWork && (
        <p class="status" aria-label="Availability">
          <span class="status__dot" aria-hidden="true" />
          {ui.availableForWork}
        </p>
      )
    }

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label={ui.openMenu}
      data-nav-toggle
      data-label-open={ui.openMenu}
      data-label-close={ui.closeMenu}
    >
      <span class="nav-toggle__open"><Icon name="menu" size="1.35rem" /></span>
      <span class="nav-toggle__close"><Icon name="close" size="1.35rem" /></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  /* Toggled by JS once the page scrolls away from the top. Opaque by
     default; the translucent treatment is layered on only where the blur
     that makes it readable is actually supported. */
  .header.is-stuck {
    background: var(--bg);
    border-bottom-color: var(--border);
  }

  @supports (backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px)) {
    .header.is-stuck {
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      backdrop-filter: blur(12px) saturate(140%);
      -webkit-backdrop-filter: blur(12px) saturate(140%);
    }
  }

  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* --- Brand --- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-right: auto;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    background: var(--bg-elev);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    transition: border-color var(--dur) var(--ease);
  }

  .brand:hover .brand__mark {
    border-color: var(--accent);
  }

  .brand__name {
    font-size: 0.9375rem;
  }

  /* --- Nav --- */
  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav__link {
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: var(--r-sm);
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--text);
    background: var(--bg-elev);
  }

  /* Set by the scroll-spy script. */
  .nav__link.is-active {
    color: var(--accent);
  }

  /* --- Language switcher --- */
  .lang {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    background: var(--bg-elev);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
  }

  .lang__item {
    padding: 0.35rem 0.6rem;
    border-radius: var(--r-pill);
    color: var(--text-dim);
    transition: color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  a.lang__item:hover {
    color: var(--text);
  }

  .lang__item.is-current {
    background: var(--bg-elev-2);
    color: var(--accent);
  }

  /* Only one of the two switchers is visible at a time. */
  .nav__lang {
    display: none;
  }

  /* --- Availability pill --- */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    background: var(--bg-elev);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .status__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-tint);
  }

  /* --- Mobile toggle --- */
  .nav-toggle {
    display: none;
    padding: 0.4rem;
    border-radius: var(--r-sm);
    color: var(--text-muted);
  }

  .nav-toggle:hover {
    color: var(--text);
  }

  .nav-toggle__close {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__close {
    display: block;
  }

  /* The availability pill is the first thing to go as space tightens. */
  @media (max-width: 1040px) {
    .status {
      display: none;
    }
  }

  /* --- Mobile layout --- */
  @media (max-width: 860px) {
    .nav-toggle {
      display: block;
    }

    /* Solid on purpose — the hero sits directly behind this panel, and a
       translucent menu is unreadable anywhere backdrop-filter is off. */
    .nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.95);
      display: none;
    }

    .nav.is-open {
      display: block;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__link {
      padding: 0.85rem 0.25rem;
      font-size: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .nav__list li:last-child .nav__link {
      border-bottom: 0;
    }

    /* Move the switcher into the panel, where there is room for it. */
    .lang--header {
      display: none;
    }

    .nav__lang {
      display: block;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 420px) {
    .brand__name {
      display: none;
    }
  }
</style>
