---
import { site, socials } from '../data/site';
import { useI18n } from '../i18n';
import Icon from './Icon.astro';

const { t, ui } = useI18n(Astro.currentLocale);
---

<section class="hero" id="top">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="eyebrow hero__item">{t(site.location)}</p>

    <h1 class="hero__name hero__item" style="--in-delay: 60ms">
      {site.name}
    </h1>

    <p class="hero__role hero__item" style="--in-delay: 120ms">
      {t(site.role)}
    </p>

    <p class="hero__tagline hero__item" style="--in-delay: 180ms">
      {t(site.tagline)}
    </p>

    <div class="hero__actions hero__item" style="--in-delay: 240ms">
      <a
        class="btn btn--primary"
        href={socials.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="linkedin" />
        LinkedIn
      </a>
      <a
        class="btn btn--ghost"
        href={socials.github.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" />
        GitHub
      </a>
      <a
        class="btn btn--ghost"
        href={site.cv.href}
        download={site.cv.filename}
      >
        <Icon name="download" />
        {ui.hero.downloadCv}
      </a>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label={ui.hero.scrollToAbout}>
    <Icon name="arrow-down" size="1rem" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(92svh, 900px);
    padding-block: clamp(5rem, 14vh, 9rem) clamp(6rem, 16vh, 10rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* Soft accent bloom behind the headline. */
  .hero__glow {
    position: absolute;
    z-index: -2;
    top: -22%;
    left: 50%;
    width: min(1100px, 130vw);
    aspect-ratio: 1;
    transform: translateX(-58%);
    background: radial-gradient(
      circle at center,
      var(--accent-glow) 0%,
      transparent 62%
    );
    opacity: 0.85;
    pointer-events: none;
  }

  /* Faint engineering grid, faded out toward the edges. */
  .hero__grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.028) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 65% at 50% 40%, #000 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(
      ellipse 80% 65% at 50% 40%,
      #000 30%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hero__inner {
    max-width: 60rem;
  }

  /* The hero is always above the fold, so it fades in on load rather than
     waiting for the scroll observer the lower sections use. Nothing here
     depends on the page script running — or on the tab ever being painted —
     so the first thing a visitor sees can never be left at opacity 0.

     `backwards` holds the start frame through the stagger delay; the moment
     the animation is over the element simply has its normal styles. */
  /* Gated on `.js` for the same reason the scroll reveal is: with scripting
     off there is nothing to fall back on, so don't start from a hidden frame
     at all. Every failure path below lands on "visible". */
  :global(.js) .hero__item {
    animation: hero-in 620ms var(--ease) var(--in-delay, 0ms) backwards;
  }

  /* A tab that never paints never advances an animation either — its timeline
     stays at 0 — so `backwards` would strand the hero on its first keyframe.
     The script sets this the moment it works out that no frame is coming. */
  :global(.reveal-instant) .hero__item {
    animation: none;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* The global reduce block zeroes durations but not delays, which would
     still hide the hero for a beat. Drop the animation outright instead. */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__item {
      animation: none;
    }
  }

  .hero__name {
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 8.5vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .hero__role {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: clamp(0.9375rem, 2.2vw, 1.1875rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .hero__tagline {
    max-width: 42rem;
    margin-top: 1.5rem;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* --- Scroll cue --- */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--text-muted);
    animation: nudge 2.6s var(--ease) infinite;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .hero__scroll:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @keyframes nudge {
    0%,
    72%,
    100% {
      transform: translateY(0);
    }
    82% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 640px) {
    .hero__scroll {
      display: none;
    }

    .hero__actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
