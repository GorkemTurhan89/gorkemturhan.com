---
/**
 * Inline SVG icons — no icon library, no runtime cost.
 *
 * Each path is drawn on a 24x24 grid. Stroke icons inherit `currentColor`
 * via `stroke`, brand glyphs are solid fills.
 */
export type IconName =
  | 'linkedin'
  | 'github'
  | 'mail'
  | 'upwork'
  | 'download'
  | 'arrow-up-right'
  | 'arrow-down'
  | 'menu'
  | 'close'
  | 'check';

interface Props {
  name: IconName;
  /** CSS size; defaults to 1em so icons scale with their text. */
  size?: string;
  class?: string;
}

const { name, size = '1em', class: className } = Astro.props;

/** Icons drawn with strokes rather than fills. */
const stroked = new Set<IconName>([
  'mail',
  'download',
  'arrow-up-right',
  'arrow-down',
  'menu',
  'close',
  'check',
]);

const isStroked = stroked.has(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isStroked ? 'none' : 'currentColor'}
  stroke={isStroked ? 'currentColor' : 'none'}
  stroke-width={isStroked ? 1.75 : undefined}
  stroke-linecap={isStroked ? 'round' : undefined}
  stroke-linejoin={isStroked ? 'round' : undefined}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'linkedin' && (
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z" />
    )
  }
  {
    name === 'github' && (
      <path d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58l-.02-2.05c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3Z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
        <path d="m3.5 7 7.34 5.14a2 2 0 0 0 2.32 0L20.5 7" />
      </>
    )
  }
  {
    name === 'upwork' && (
      <path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06a2.705 2.705 0 0 1 2.703 2.703 2.707 2.707 0 0 1-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.548a2.55 2.55 0 0 1-2.548-2.548V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3-2.439-5.439-5.439-5.439z" />
    )
  }
  {
    name === 'download' && (
      <path d="M12 3.5v11m0 0 4.25-4.25M12 14.5 7.75 10.25M4 17.5v1A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-1" />
    )
  }
  {
    name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />
  }
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
