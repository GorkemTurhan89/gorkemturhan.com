---
interface Props {
  title: string;
  /** Optional supporting line under the title. */
  lead?: string;
}

const { title, lead } = Astro.props;
---

<div class="heading" data-reveal>
  <h2 class="heading__title">{title}</h2>
  {lead && <p class="heading__lead">{lead}</p>}
</div>

<style>
  .heading {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .heading__title {
    font-size: clamp(1.75rem, 4.2vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .heading__lead {
    max-width: 44rem;
    margin-top: 0.85rem;
    color: var(--text-muted);
  }
</style>
