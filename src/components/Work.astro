---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { projectGroups } from '../data/projects';
import { useI18n } from '../i18n';

const { t, ui } = useI18n(Astro.currentLocale);
---

<section class="section" id="work">
  <div class="container">
    <SectionHeading
      title={ui.sections.work.title}
      lead={ui.sections.work.lead}
    />

    {
      projectGroups.map((group, groupIndex) => (
        <div class="group">
          <div class="group__header" data-reveal>
            <h3 class="group__title">{t(group.title)}</h3>
            <p class="group__summary">{t(group.summary)}</p>
          </div>

          <ul class="grid">
            {group.projects.map((project, i) => (
              <li
                class="card project"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                {project.badge && (
                  <span class="project__badge">{t(project.badge)}</span>
                )}

                <h4 class="project__title">{t(project.title)}</h4>
                <p class="project__desc">{t(project.description)}</p>

                <ul class="chip-list project__tech">
                  {project.technologies.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>

                {(project.github || project.demo) && (
                  <div class="project__links">
                    {project.github && (
                      <a
                        class="project__link"
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={ui.work.codeAria(t(project.title))}
                      >
                        <Icon name="github" size="0.95rem" />
                        {ui.work.code}
                      </a>
                    )}
                    {project.demo && (
                      <a
                        class="project__link"
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={ui.work.demoAria(t(project.title))}
                      >
                        <Icon name="arrow-up-right" size="0.95rem" />
                        {ui.work.liveDemo}
                      </a>
                    )}
                  </div>
                )}
              </li>
            ))}
          </ul>

          {groupIndex < projectGroups.length - 1 && <div class="group__gap" />}
        </div>
      ))
    }
  </div>
</section>

<style>
  .group__header {
    margin-bottom: 1.5rem;
  }

  .group__title {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .group__summary {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .group__gap {
    height: clamp(3rem, 6vw, 4.5rem);
  }

  /* 20rem gives three columns at desktop width, so the QA row fills exactly.
     A group with a single project collapses to one full-width feature card,
     which is what `auto-fit` does with empty tracks. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  /* --- Project card --- */
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .project:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px -18px rgba(0, 0, 0, 0.9);
  }

  .project__badge {
    align-self: flex-start;
    margin-bottom: 0.85rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--accent-tint);
    border-radius: var(--r-pill);
    background: var(--accent-tint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .project__title {
    font-size: 1.0625rem;
  }

  .project__desc {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* Pushes the links to the bottom so cards in a row line up. */
  .project__tech {
    margin-top: 1.15rem;
    margin-bottom: 1.25rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--dur) var(--ease);
  }

  .project__link:hover {
    color: var(--accent);
  }
</style>
