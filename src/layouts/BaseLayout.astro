---
import { site, socials } from '../data/site';
import { LANGS, LANG_META, pathFor, useI18n } from '../i18n';
import '../styles/global.css';

const { lang, t, ui } = useI18n(Astro.currentLocale);

const title = `${site.name} — ${t(site.role)}`;
const description = t(site.description);

/* Astro.site comes from `site` in astro.config.mjs; fall back to the
   configured origin so `astro dev` still emits absolute URLs. */
const origin = Astro.site?.origin ?? site.url;
const canonical = new URL(pathFor(lang), origin).href;
const ogImage = new URL(t(site.ogImage), origin).href;

/* Tell search engines about the other language, and which one to serve when
   they cannot infer a preference. */
const alternates = LANGS.map((code) => ({
  code,
  href: new URL(pathFor(code), origin).href,
}));

/* Structured data helps search engines render a richer result for a name. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: t(site.role),
  description,
  url: site.url,
  email: socials.email.href.replace('mailto:', ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: t(site.location),
  },
  sameAs: [socials.linkedin.href, socials.github.href],
  knowsAbout: t(site.keywords),
  knowsLanguage: ['tr', 'en'],
};
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.code} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', origin).href} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content={t(site.keywords).join(', ')} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0b0d" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {
      LANGS.filter((code) => code !== lang).map((code) => (
        <meta
          property="og:locale:alternate"
          content={LANG_META[code].ogLocale}
        />
      ))
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${t(site.role)}`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: two families, subset and swapped in by Google Fonts. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Marks the document as scripted before paint, so reveal animations
         never leave content hidden when JS is unavailable. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <slot />

    <script>
      /**
       * Page behaviour. Four small, independent pieces of vanilla JS:
       * reveal-on-scroll, a sticky-header state, the mobile menu, and a nav
       * scroll-spy.
       *
       * Everything degrades gracefully — without JS the page is fully readable,
       * just without the polish. Reveal comes first on purpose: it is the only
       * one holding content back, so nothing else may run ahead of it.
       */

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      /* --- 1. Reveal on scroll ---
         `.js [data-reveal]` hides this content up front and only the code
         below hands it back, so this block runs before anything that could
         throw underneath it. */
      const revealTargets = document.querySelectorAll('[data-reveal]');
      const revealAll = () => {
        /* Skip the fade, don't just trigger it — see .reveal-instant. */
        document.documentElement.classList.add('reveal-instant');
        revealTargets.forEach((el) => el.classList.add('is-revealed'));
      };

      if (prefersReducedMotion || typeof IntersectionObserver !== 'function') {
        revealAll();
      } else {
        const reveal = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        revealTargets.forEach((el) => reveal.observe(el));

        /* A tab that is never painted — a background load, a crawler, a link
           preview renderer — runs no frames, so the observer never fires and
           the page stays blank with all of its text sitting in the DOM.
           Timers do still run there, so take one animation frame as proof
           that painting happens at all, and reveal everything outright if it
           never arrives. */
        let painted = false;
        requestAnimationFrame(() => {
          painted = true;
        });
        setTimeout(() => {
          if (!painted) revealAll();
        }, 1200);
      }

      /* --- 2. Sticky header: add a background once we leave the top --- */
      const header = document.getElementById('site-header');

      if (header) {
        const onScroll = () => {
          header.classList.toggle('is-stuck', window.scrollY > 8);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      /* --- 3. Mobile menu --- */
      const nav = document.getElementById('primary-nav');
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

      if (nav && toggle) {
        /* Labels are rendered onto the button so they stay translated —
           this script is shared by both languages. */
        const labelOpen = toggle.dataset.labelOpen ?? 'Open menu';
        const labelClose = toggle.dataset.labelClose ?? 'Close menu';

        const setOpen = (open: boolean) => {
          nav.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
        };

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        /* Close after picking a destination, or on Escape. */
        nav.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) setOpen(false);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
      }

      /* --- 4. Scroll-spy: highlight the nav link for the section in view --- */
      const navLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'),
      );

      const sections = navLinks
        .map((link) => document.querySelector(link.hash))
        .filter((section): section is Element => section !== null);

      if (sections.length > 0) {
        /* Track ratios ourselves so the *most* visible section wins, rather
           than whichever one fired an entry most recently. */
        const ratios = new Map<string, number>();

        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              ratios.set(entry.target.id, entry.intersectionRatio);
            }

            let bestId = '';
            let bestRatio = 0;
            for (const [id, ratio] of ratios) {
              if (ratio > bestRatio) {
                bestRatio = ratio;
                bestId = id;
              }
            }

            for (const link of navLinks) {
              link.classList.toggle('is-active', link.hash === `#${bestId}`);
            }
          },
          { threshold: [0, 0.15, 0.3, 0.5, 0.75, 1] },
        );

        sections.forEach((section) => spy.observe(section));
      }
    </script>
  </body>
</html>
